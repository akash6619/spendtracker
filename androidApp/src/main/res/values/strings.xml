    <string name="onboarding_title">Understand your spending privately</string>
    <string name="onboarding_body">SpendTracker reads financial SMS from the previous three months, identifies transactions on this device, and ignores messages it cannot safely recognize.</string>
    <string name="onboarding_privacy_title">Your messages stay private</string>
    <string name="onboarding_privacy_body">Message bodies are not saved by SpendTracker and nothing is sent off this device.</string>
    <string name="permission_required_title">Allow SMS access</string>
    <string name="permission_required_body">Android requires your permission before SpendTracker can read the inbox. You can revoke it later in system settings.</string>
