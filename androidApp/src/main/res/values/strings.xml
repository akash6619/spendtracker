    <string name="onboarding_title">Understand your spending privately</string>
    <string name="onboarding_body">SpendTracker reads financial SMS from the previous three months, identifies transactions on this device, and ignores messages it cannot safely recognize.</string>
    <string name="onboarding_privacy_title">Your messages stay private</string>
    <string name="onboarding_privacy_body">Message bodies are not saved by SpendTracker and nothing is sent off this device.</string>
    <string name="permission_required_title">Allow SMS access</string>
    <string name="permission_required_body">Android requires your permission before SpendTracker can read the inbox. You can revoke it later in system settings.</string>
    <string name="permission_granted_title">Ready to scan</string>
    <string name="permission_granted_body">SMS access is enabled. Start the local three-month scan when you are ready.</string>
    <string name="permission_denied_title">SMS access was denied</string>
    <string name="permission_denied_body">SpendTracker cannot scan messages without access. You can review the privacy explanation and try again.</string>
    <string name="permission_blocked_title">Enable SMS access in Settings</string>
    <string name="permission_blocked_body">Android is no longer showing the permission prompt. Open app settings to allow SMS access.</string>
    <string name="permission_revoked_title">SMS access was revoked</string>
    <string name="permission_revoked_body">Stored transactions remain available, but scans are paused until access is restored in app settings.</string>
