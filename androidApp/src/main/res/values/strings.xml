    <string name="import_window">Reads the previous three calendar months only, on this device.</string>
    <string name="what_counts_title">What counts as spend</string>
    <string name="what_counts_body">Debit purchases and fees are included. Credits, refunds, transfers, and ATM withdrawals stay visible but excluded from totals. You can change either per transaction.</string>
    <string name="foreign_explanation_short">Foreign-currency records keep their original currency and are never converted; they are excluded from INR totals.</string>
    <string name="data_lifecycle_title">Delete all SpendTracker data</string>
    <string name="data_lifecycle_body">Removes every stored transaction, category change, import status, and the local fingerprint key from this device. Revoking SMS access (in system Settings) is separate and stops future scans without deleting stored data.</string>
